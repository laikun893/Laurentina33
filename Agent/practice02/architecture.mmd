%% Architecture diagram of chat_fileops.py
%% AI file-operation assistant based on an OpenAI-compatible API (DeepSeek)
%% Rendering: any Mermaid-capable viewer (GitHub / VS Code Mermaid plugin)
%%
%% Layer index
%%   (1) Config layer         -> config.ini + configparser + OpenAI client
%%   (2) Declarations         -> WORK_ROOT, MAX_TEXT_SIZE, TOOLS schemas
%%   (3) Helpers              -> _safe_path (sandbox), _is_text_file (binary guard)
%%   (4) Tool implementations -> 11 tool functions
%%   (5) Dispatcher           -> run_tool(name, arguments)
%%   (6) Agent runtime        -> while True main loop with tool-call handling
%%   (7) External deps        -> DeepSeek API + Python standard library
%%
%% Notes
%%   Solid arrows  : call / data flow
%%   Dashed arrows : validation and error rollback paths
%%
%% ---------------------------------------------------------------------------
%% BEGIN DIAGRAM
%% ---------------------------------------------------------------------------

flowchart TB

    subgraph CFG["(1) Config Layer"]
        direction TB
        CFG1["config.ini<br/>[default] base_url / model / api_key"]
        CFG2["configparser reads config<br/>missing file / section / field -> sys.exit"]
        CFG3["OpenAI client<br/>OpenAI(base_url, api_key)"]
        CFG1 --> CFG2 --> CFG3
    end

    subgraph DECL["(2) Declarations"]
        direction TB
        CONST["WORK_ROOT = os.getcwd()<br/>MAX_TEXT_SIZE = 1MB"]
        TOOLS["TOOLS list (11 function schemas)<br/>JSON Schema params for the model"]
    end

    CFG3 --> CONST
    CFG3 --> TOOLS

    subgraph HELP["(3) Helpers"]
        direction TB
        H1["_safe_path(path) -> (abs_path, err)<br/>abspath + commonpath check<br/>reject paths outside WORK_ROOT"]
        H2["_is_text_file(path) -> (bool, err)<br/>read first 1024 bytes<br/>NUL check + incremental UTF-8 decode"]
    end

    CONST --> HELP

    subgraph TOOLS_IMPL["(4) Tool Implementations"]
        direction TB
        T0["get_current_time()<br/>datetime.datetime.now()<br/>date / time / weekday / tz-aware ISO"]
        T1["get_current_dir()<br/>returns os.getcwd()"]
        T2["list_dir(path='.')<br/>tags [DIR] / [FILE]"]
        T3["get_file_type(path)<br/>mimetypes MIME + extension"]
        T4["read_file(path)<br/>size cap + text check"]
        T5["create_file(directory, filename, content='')<br/>makedirs + write UTF-8"]
        T6["edit_file(path, content, mode)<br/>overwrite / append"]
        T7["create_dir(path)<br/>os.makedirs"]
        T8["delete_dir(path)<br/>shutil.rmtree (recursive)"]
        T9["delete_file(path)<br/>os.remove"]
        T10["rename_path(old_path, new_path)<br/>os.rename"]
    end

    H1 -.->|path check| T2
    H1 -.->|path check| T3
    H1 -.->|path check| T4
    H1 -.->|path check| T5
    H1 -.->|path check| T6
    H1 -.->|path check| T7
    H1 -.->|path check| T8
    H1 -.->|path check| T9
    H1 -.->|path check| T10
    H2 -.->|text check| T4
    H2 -.->|text check| T6

    subgraph DISPATCH["(5) Dispatcher"]
        RT["run_tool(name, arguments)<br/>routes by function name<br/>unknown tool -> message"]
    end

    RT --> T0
    RT --> T1
    RT --> T2
    RT --> T3
    RT --> T4
    RT --> T5
    RT --> T6
    RT --> T7
    RT --> T8
    RT --> T9
    RT --> T10

    subgraph RUNTIME["(6) Agent Runtime (while True)"]
        direction TB
        R1["input('prompt:')<br/>EOFError / KeyboardInterrupt -> exit"]
        R2["messages.append(user)"]
        R3["client.chat.completions.create(<br/>model, messages, tools=TOOLS)"]
        R4{"message.tool_calls ?"}
        R5["append assistant message<br/>(content + tool_calls)"]
        R6["run each tool<br/>json.loads(arguments)<br/>print result"]
        R7["append tool results + tool_call_id"]
        R8["print final answer<br/>messages.append(assistant)"]
        R9["on Exception: print API error<br/>messages.pop() rollback"]

        R1 --> R2 --> R3 --> R4
        R4 -->|yes| R5 --> R6 --> R7 --> R3
        R4 -->|no| R8
        R8 --> R1
        R3 -.->|Exception| R9
        R6 -.->|Exception| R9
        R9 --> R1
    end

    TOOLS -->|inject tool schemas| R3
    R6 -->|invoke| RT
    RT -.->|results| R7

    subgraph EXT["(7) External Dependencies"]
        E1["DeepSeek API<br/>https://api.deepseek.com"]
        E2["stdlib: os / sys / json / shutil<br/>codecs / datetime / mimetypes / configparser"]
    end

    R3 <-->|HTTPS request / response| E1
    TOOLS_IMPL --- E2

    classDef cfg fill:#e3f2fd,stroke:#1565c0,color:#0d47a1
    classDef decl fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20
    classDef help fill:#fff8e1,stroke:#f9a825,color:#f57f17
    classDef impl fill:#f3e5f5,stroke:#6a1b9a,color:#4a148c
    classDef disp fill:#fce4ec,stroke:#ad1457,color:#880e4f
    classDef runtime fill:#e0f7fa,stroke:#00838f,color:#006064
    classDef ext fill:#eceff1,stroke:#455a64,color:#263238

    class CFG1,CFG2,CFG3 cfg
    class CONST,TOOLS decl
    class H1,H2 help
    class T0,T1,T2,T3,T4,T5,T6,T7,T8,T9,T10 impl
    class RT disp
    class R1,R2,R3,R4,R5,R6,R7,R8,R9 runtime
    class E1,E2 ext
