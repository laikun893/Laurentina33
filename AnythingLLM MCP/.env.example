# Base URL of the AnythingLLM API (no trailing slash).
ANYTHINGLLM_BASE_URL=http://localhost:3001/api

# Developer API key from AnythingLLM -> Settings -> Tools -> Developer API.
ANYTHINGLLM_API_KEY=your-api-key-here

# Optional request timeout in seconds.
ANYTHINGLLM_TIMEOUT=60

# Workspace to answer from. Leave empty to use the only workspace automatically.
ANYTHINGLLM_WORKSPACE=

# Streamable HTTP transport settings.
MCP_HOST=127.0.0.1
MCP_PORT=8000
